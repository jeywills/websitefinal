# --- Storage -----------------------------------------------------------------
# Unset = in-memory store with demo keys (local dev only; refuses to boot in production).
# Supabase: Project Settings → Database → Connection string → Transaction pooler (port 6543).
DATABASE_URL=
# PEM of Supabase's CA (Database settings → SSL) for verified TLS. Use literal \n for newlines.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5

# --- Access ------------------------------------------------------------------
# Bearer token for /admin/* (create accounts, operator keys). Unset = admin routes disabled.
OUTCOME_ADMIN_TOKEN=
# Vercel sends this on cron calls to /cron/tick.
CRON_SECRET=

# --- Billing -----------------------------------------------------------------
# Set = each accepted unit becomes a Stripe invoice item. Unset = ledger only.
STRIPE_SECRET_KEY=

# --- Fulfilment --------------------------------------------------------------
# Every task event is POSTed here, signed with the secret (point it at an n8n webhook).
OPERATOR_WEBHOOK_URL=
OPERATOR_WEBHOOK_SECRET=

# --- Presentation ------------------------------------------------------------
PUBLIC_BASE_URL=
PROVIDER_NAME=Revenue House
QUOTE_TTL_HOURS=24
